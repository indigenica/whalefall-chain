# Lyman-alpha likelihood based on the alpha-beta-gamma-delta
# approach described in detail in 2206.08188. Likelihood
# written by D. C. Hooper, N. Schoeneberg, R. Murgia,
# M. Archidiacono, J. Lesgourgues, and M. Viel.
# This is an extension to the alpha-beta-gamma likelihood
# discussed in 1907.01496.

# This likelihood should always be used together with
# a CMB likelihood (e.g. Planck), and is only
# applicable for models that can be described by the
# alpha-beta-gamma-delta (or alpha-beta-gamma) parameterisations.

# Important! This likelihood requires CLASS version 2.9 or higher.

# Make the likelihood more talkative by increasing the number
Lya_abgd_whale.verbose = 0

# In all normal circumstances you run this likelihood for models with
# a power suppression. If you are intending to run with a normal LCDM
# model for some unknown reason, then turn this flag on.
# isLCDM is set below (WHALEFALL block)

## Physical parameters ##
# z and k (in s/km) values for the lyman-alpha slope,
# can be changed with some care
Lya_abgd_whale.k_s_over_km = 0.009
Lya_abgd_whale.z = 3.

# Other k (in h/Mpc) values used in the comparisons and checks
Lya_abgd_whale.kmax  = 200.
Lya_abgd_whale.kmin  = 0.01
Lya_abgd_whale.k_size = 500


## Dataset definition ##
# Which dataset we are using?
Lya_abgd_whale.DATASET = "mike-hires"
Lya_abgd_whale.zp = 4.5

# The redshift array had first the XQ-100 z (low z) and then the MIKE HIRES z (high z),
# so we need num_z_XQ to rescale the redshift array when using only MIKE HIRES
Lya_abgd_whale.num_z_XQ = 7
# z with overlapping data of both XQ-100 and MIKE HIRES
Lya_abgd_whale.num_z_overlap = 1


## File structure and grid files ##
# Data directory and bin file (for models that fail the checks)
Lya_abgd_whale.data_directory   = data.path['data']
Lya_abgd_whale.bin_file_name = "Lya_abgd_bin_file.txt"

# Files corresponding to grid of simulations
Lya_abgd_whale.abg_grid_file = "Lya_grid/ABG_only_grid.dat"
Lya_abgd_whale.abg_grid_size = 109
Lya_abgd_whale.abd_grid_file = "Lya_grid/ABD_only_grid_sept2020.dat"
Lya_abgd_whale.abd_grid_size = 83
Lya_abgd_whale.thermal_grid_file = "Lya_grid/ABG_thermalWDM_only_grid.dat"
Lya_abgd_whale.thermal_grid_size = 8
Lya_abgd_whale.astro_spectra_file = "Lya_grid/full_matrix_interpolated_ASTRO.pkl"
Lya_abgd_whale.abg_spectra_file = "Lya_grid/full_matrix_interpolated_ABG_only.pkl"
Lya_abgd_whale.abd_spectra_file = "Lya_grid/full_matrix_interpolated_ABD_only_sept2020.pkl"
Lya_abgd_whale.thermal_spectra_file = "Lya_grid/full_matrix_interpolated_thermalWDM_only.pkl"
Lya_abgd_whale.lcdm_spectra_file = "Lya_grid/full_matrix_interpolated_LCDM.pkl"
Lya_abgd_whale.astro_grid_file = "Lya_grid/kriging_GRID_2R_astro_18p_HR_noPRACE.dat"
Lya_abgd_whale.MIKE_spectra_file = "Lya_grid/y_M_reshaped.pkl"
Lya_abgd_whale.HIRES_spectra_file = "Lya_grid/y_H_reshaped.pkl"
Lya_abgd_whale.MIKE_cov_file = "Lya_grid/cov_M_inverted.pkl"
Lya_abgd_whale.HIRES_cov_file = "Lya_grid/cov_H_inverted.pkl"
Lya_abgd_whale.PF_noPRACE_file = "Lya_grid/PF_noPRACE.pkl"


## Interpolation/weighing parameters ##
# Parameters related to the simulations in the grid
Lya_abgd_whale.epsilon_astro = 1e-8
Lya_abgd_whale.exponent_astro = 6.
Lya_abgd_whale.epsilon_tk = 1e-8
Lya_abgd_whale.exponent_tk = 6.

# Parameters relevant for the fitting function
# Correspond to min/max values for the simulations
Lya_abgd_whale.alpha_min_abg = 0.
Lya_abgd_whale.alpha_max_abg = 0.17
Lya_abgd_whale.beta_min_abg = 1.5
Lya_abgd_whale.beta_max_abg = 10.
Lya_abgd_whale.gamma_min_abg = -10.
Lya_abgd_whale.gamma_max_abg = -0.15
Lya_abgd_whale.alpha_min_abd = 0.
Lya_abgd_whale.alpha_max_abd = 0.1
Lya_abgd_whale.beta_min_abd = 1.3
Lya_abgd_whale.beta_max_abd = 6.89
Lya_abgd_whale.delta_min_abd = 0.
Lya_abgd_whale.delta_max_abd = 1.


## Likelihood options for interpolation, smoothing, fitting ##
# Smoothing options, to take care of smoothing oscillations
# at large k. Available smoothing methods are:
# ["None", "logk_smoothing", "increasing_smoothing_logk", "fit_abgd"].
Lya_abgd_whale.smoothing_method = "None"
Lya_abgd_whale.smoothing_scale_logk = 0.2
# The parameter scale of around 1, has to be found good for log(k), similar to d^2T/dlnk^2 > 0.005
Lya_abgd_whale.logk_scale_abgd_fit = 1.
Lya_abgd_whale.d2_Tk_dlnk2_abgd_limit = 0.005

# Fitting options, to find the nearest grid points. Available
# fitting methods are:
# ["None", "bounded", "hybrid", "hybrid_bounded", "regularized"]
Lya_abgd_whale.use_least_square = "None"
# When using the hybrid method, how much weight do we give each
# method? (0 = leastsquare, infinity = weight distance, ~1 for strong
# LS preference, ~10000 for strong WD preference)
Lya_abgd_whale.use_lstsq_vs_nearest = 10.0
# When using regularized, how do we weight the grid? (0 = leastsquare,
# infinity = all weights as small as possible, 0.1 appears optimal)
Lya_abgd_whale.regularized_lambda = 0.1

# Parameters related to area criterion and distance to weights (derived parameters)
Lya_abgd_whale.area_criterion_kmax = 20.
Lya_abgd_whale.area_criterion_kmin = 0.5
Lya_abgd_whale.weight_min = 0.001

## Options for test runs
# Do we want a coverage test? This shows where the likelihood
# passes all sanity checks, does not compare model to Lyman_alpha data.
Lya_abgd_whale.TEST_nodata_run = False
# Keep astrophysical parameters fixed to the fiducial values? (acts as
# a marginalisation over astro, can speed up run but less reliable.
Lya_abgd_whale.TEST_set_astro_to_fiducial = False


## List of nuisance parameters expected by the likelihood
# WHALEFALL: s_tail added (the first definition of an option wins in MontePython)
Lya_abgd_whale.use_nuisance = ['T0a','T0s','gamma_a','gamma_s','Fz1','Fz2','Fz3','Fz4','F_UV','s_tail']

## WHALEFALL U15b (docs/preregistros/ESPEC_U15b.md) ##
# Transfer-function table T^2(k; s) = P_model/P_LCDM (z = 0, fiducial cosmology of lya/u4a_class.py), written by
# lya/u15b/prepare_tables.py.  Set per run in the .param file:  Lya_abgd_whale.table_file = '/abs/path/to/<name>.npz'
Lya_abgd_whale.table_file = ''
# Name of the amplitude parameter (nuisance in the .param file); s = 0 is LCDM, s = 1 the whale row (or f for validation)
Lya_abgd_whale.amp_name = 's_tail'
# The model enters only through T^2, so the CLASS run of each step is LCDM: the parent likelihood must not look for
# non-LCDM parameters to remove.
Lya_abgd_whale.isLCDM = True
